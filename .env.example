APP_NAME=Rukoon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://warga.domainanda.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=siwarga
DB_USERNAME=siwarga
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# IP reverse proxy yang dipercaya (default 127.0.0.1,::1)
TRUSTED_PROXIES=127.0.0.1,::1

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# ---------- Identitas wilayah (bisa diubah lagi di menu Pengaturan) ----------
SIWARGA_NAMA_RW="RW 02"
SIWARGA_DUSUN=Sidorejo
SIWARGA_KELURAHAN=Selomartani
SIWARGA_KECAMATAN=Kalasan
SIWARGA_KABUPATEN=Sleman
SIWARGA_PROVINSI="D.I. Yogyakarta"
SIWARGA_JATUH_TEMPO=10

# ---------- Peta wilayah ----------
# Kosong = peta OpenStreetMap + satelit Esri (gratis). Isi dengan API key Google (Map Tiles API) untuk satelit Google.
GOOGLE_MAPS_KEY=
# Warga melihat rumah lain di peta sebagai: nama | titik | sendiri
SIWARGA_PETA_WARGA=nama

# Akun admin RW pertama (dipakai oleh: php artisan db:seed)
ADMIN_NAME="Admin RW"
ADMIN_EMAIL=admin@rw.local
ADMIN_PASSWORD=

# ---------- AINO Payment Gateway (QRIS) ----------
# Development: https://svc-core-go-dev.ainosi.com   Production: https://apg.ainosi.com
AINO_BASE_URL=https://svc-core-go-dev.ainosi.com
AINO_MERCHANT_CODE=
AINO_SECRET_KEY=
AINO_PAYMENT_TYPE=qr
AINO_GENERATE_PATH=/payment/v1/request
AINO_INQUIRY_PATH=/payment/v1/inquiry
# Kosongkan = otomatis ${APP_URL}/aino/notify (harus HTTPS)
AINO_CALLBACK_URL=
AINO_TIMEOUT=8
AINO_BIAYA_PERSEN=0
AINO_DONASI_MINIMAL=10000
# true = tampilkan pilihan Rp1 untuk uji coba donasi QRIS (matikan di produksi)
AINO_DONASI_UJI=false
AINO_DEFAULT_EXPIRY=15
# Opsional, contoh: 103.10.20.30,103.10.20.31
AINO_ALLOWED_IPS=
